# Прогон 2 (только чтение) для модели PY_SDK ##1.0.
# Скопируйте содержимое в .env и вставьте свой токен в OM_TOKEN.
# Значения взяты из report.json первого прогона. Строки с «← создать в модели»
# заработают, только если создать объект в модели (см. план в чате);
# пока они пустые, соответствующие вызовы будут skipped.

OM_WS_URL=https://ws125.optimacros.com
OM_TOKEN=ваш_токен
OM_MODEL_ID=74174c947beb584189fb42acf112d69b
OM_MODEL_NAME=
OM_WORK_DIR=./sdk_probe_files_run2

OM_SKIP_WRITE=1
OM_TEST_ADMIN=0
OM_TEST_RESTORE=0
# Бэкап модели весит 0.124 МБ — скачиваем
OM_TEST_DOWNLOAD_BACKUP=1
OM_TEST_MC_COPY=0
OM_SAVE_DATAFRAMES=1
OM_PROBE_TIMEOUT=600
OM_GROUPS=

# --- Объекты для чтения ---
# SRC_MC: 90 ячеек, время 13000000003, версии 20000000020
OM_TEST_MULTICUBE=SRC_MC
OM_TEST_MC_VIEW=
# Пользовательских справочников в модели нет. Пока читаем системный Access Levels;
# лучше создать свой (см. план) и вписать сюда его имя.
OM_TEST_CATALOG=Access Levels
OM_TEST_CATALOG_VIEW=

# Фильтры. Измерение 13000000003 — временная шкала SRC_MC.
# Булевого куба в SRC_MC нет ← создать в модели и вписать его longId
OM_TEST_BOOLEAN_CUBE_ID=
OM_TEST_FILTER_DIMENSION_ID=13000000003
OM_TEST_FILTER_FORMULA="'SRC_MC'.'куб_1' = 1"
OM_TEST_TIME_DIMENSION_ID=13000000003

# куб_1 в SRC_MC, формула '1'
OM_TEST_CUBE_ID=204000000002
# Дашбордов в модели нет ← создать в модели
OM_TEST_DASHBOARD_ID=
# Оптимизационных запросов нет ← создать в модели (по желанию)
OM_TEST_OPTIMIZATION_ID=
# Скриптов нет (get_script_list вернул []) ← создать в модели
OM_TEST_SCRIPT_ID=
# первый администратор в пользователях модели / первый пользователь WS
OM_TEST_MODEL_USER_ID=111000000180
OM_TEST_WS_USER_ID=111000000880
# Бэкап #47329 от 2026-09-23
OM_TEST_BACKUP_ROW_ID=41000047329
OM_TEST_BACKUP_ID=#47329
# Справочник с UAM ← создать в модели (системные Roles/Users/Access Levels
# SDK считает UAM-справочниками, но get_uam на них падает)
OM_TEST_UAM_LIST_ID=

# --- Объекты для записи (понадобятся в прогоне 3) ---
OM_TEST_TARGET_MULTICUBE=DEST_MC
OM_TEST_CELL_VALUE=
OM_TEST_CELL_CUBE_ID=
OM_TEST_CELL_DIMENSION_ID=
# куб_2 в SRC_MC, формула '2'; проверим смену на '3' и откат
OM_TEST_FORMULA_CUBE_ID=204000000003
OM_TEST_FORMULA_NEW=3
# Ролей в модели нет (у матриц прав ноль ролевых колонок) ← создать роль
OM_TEST_ROLE_ID=
# Forecast
OM_TEST_VERSION_ID=107000000002
OM_TEST_PERMISSION_SET=read
OM_TEST_PERMISSION_RESTORE=
OM_TEST_UAM_ITEM_ID=
OM_TEST_UAM_USER=
OM_TEST_UAM_SET=read
OM_TEST_UAM_RESTORE=
OM_TEST_SOLUTION_ZIP=
