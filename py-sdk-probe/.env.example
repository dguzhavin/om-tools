# sdk_probe.py — стенд проверки всех методов os_ws_sdk 1.0
# Скопируйте в .env (рядом со скриптом) и заполните.
# Обязательные: OM_WS_URL, OM_TOKEN, модель, OM_TEST_MULTICUBE, OM_TEST_CATALOG.
# Остальное необязательно: если переменная пустая, соответствующий вызов
# попадёт в отчёт как «skipped» с причиной.

# ============================================================================
# Подключение
# ============================================================================
OM_WS_URL=https://ws000.optimacros.com
OM_TOKEN=ваш_токен
# Модель: достаточно одного из двух (ID приоритетнее). Только ТЕСТОВАЯ модель.
OM_MODEL_ID=
OM_MODEL_NAME=SDK_PROBE

# Рабочая папка: выгрузки, results/ с DataFrame, report.json, report.md
OM_WORK_DIR=./sdk_probe_files

# ============================================================================
# Режимы
# ============================================================================
# 1 = только чтение (пишущие группы пропускаются). Первый прогон — с 1.
OM_SKIP_WRITE=1
# 1 = recalculate, backup, stop/start модели. Модель будет недоступна на время теста.
OM_TEST_ADMIN=0
# 1 = model.restore(). ОТКАТЫВАЕТ МОДЕЛЬ к бэкапу. Работает только вместе с OM_TEST_ADMIN=1.
OM_TEST_RESTORE=0
# 1 = скачать бэкап через get_backup (может весить гигабайты)
OM_TEST_DOWNLOAD_BACKUP=0
# 1 = проверить import_from_multicube / export_to_multicube между
#     OM_TEST_MULTICUBE и OM_TEST_TARGET_MULTICUBE (структуры должны совпадать)
OM_TEST_MC_COPY=0
# 1 = сохранять полученные DataFrame (до 2000 строк) в results/
OM_SAVE_DATAFRAMES=1
# Таймаут одного вызова, секунды
OM_PROBE_TIMEOUT=600
# Запустить только часть групп (через запятую). Пусто = все.
# imports, workspace, model, system_grids, multicube, mc_view, catalog, catalog_view,
# formulas_read, permissions_read, uam_read, users, scripts, dashboards, optimizer,
# backups, catalog_write, multicube_write, formulas_write, permissions_write,
# uam_write, scripts_write, optimizer_write, admin
OM_GROUPS=

# ============================================================================
# Объекты для чтения
# ============================================================================
# Мультикуб для экспорта во всех форматах. Лучше небольшой, с 2–3 измерениями,
# числовым, текстовым и булевым кубом.
OM_TEST_MULTICUBE=SDK_PROBE Источник
# Сохранённое вью этого мультикуба (пусто = первое из get_views)
OM_TEST_MC_VIEW=
# Справочник для чтения (не меняется)
OM_TEST_CATALOG=SDK_PROBE Справочник
# Вью справочника (пусто = первое из get_views)
OM_TEST_CATALOG_VIEW=

# Фильтры экспорта. Для filter_boolean_cube и filter_formula нужны оба: куб/формула и измерение.
# longId булевого куба в OM_TEST_MULTICUBE
OM_TEST_BOOLEAN_CUBE_ID=
# longId измерения, по которому фильтруются строки
OM_TEST_FILTER_DIMENSION_ID=
# Формула-фильтр. ОБЯЗАТЕЛЬНО в двойных кавычках: одинарные кавычки внутри формулы
# ломают разбор .env (python-dotenv молча пропустит строку). Пример:
# OM_TEST_FILTER_FORMULA="'SDK_PROBE Источник'.'Флаг' = TRUE"
OM_TEST_FILTER_FORMULA=

# Дополнительные id измерений через запятую: стенд повторит фильтры export_file с каждым.
# Нужно, когда непонятно, какое измерение ждёт filter_boolean_cube / filter_formula.
OM_TEST_FILTER_DIMENSION_ALT=

# longId куба для чтения формулы
OM_TEST_CUBE_ID=
# id дашборда (возьмите из DASHBOARDS_GRID после первого прогона)
OM_TEST_DASHBOARD_ID=
# id оптимизационного запроса (экспорт LP + map)
OM_TEST_OPTIMIZATION_ID=
# id скрипта: get_script_info, история; при записи — run_script и права на макрос
OM_TEST_SCRIPT_ID=
# long id строки пользователя модели / WS (из get_model_user_list / get_ws_user_list)
OM_TEST_MODEL_USER_ID=
OM_TEST_WS_USER_ID=
# long id строки бэкапа в гриде (для get_backup_info) и короткий id (для get_backup, например #227)
OM_TEST_BACKUP_ROW_ID=
OM_TEST_BACKUP_ID=
# Справочник с включённым UAM (пусто = первый из get_enabled_list_ids)
OM_TEST_UAM_LIST_ID=
# id временного измерения (колонка Time Scale в MULTICUBES_GRID) — пробуем как контекст
# для TIME_*_SUBSETS_GRID, которые без контекста падают
OM_TEST_TIME_DIMENSION_ID=

# ============================================================================
# Объекты для записи (нужны только при OM_SKIP_WRITE=0)
# ============================================================================
# Справочники стенд создаёт сам (SDK_PROBE_<время>_A/B/C) и удаляет в конце.

# Мультикуб-приёмник: стенд сохраняет его данные, очищает, импортирует обратно
# и в конце восстанавливает. Не указывайте мультикуб с ценными данными.
OM_TEST_TARGET_MULTICUBE=SDK_PROBE Приёмник

# change_cell_value(value, cube_id, dimension_id) на приёмнике. Смысл dimension_id
# не документирован — заполняйте, только если понимаете, какую ячейку меняете.
OM_TEST_CELL_VALUE=
OM_TEST_CELL_CUBE_ID=
OM_TEST_CELL_DIMENSION_ID=

# Куб, формулу которого можно временно поменять. Стенд запоминает исходную и откатывает.
OM_TEST_FORMULA_CUBE_ID=
# Новая формула для проверки (пусто = только проверка no-op с той же формулой)
OM_TEST_FORMULA_NEW=

# Права: роль и уровни. Стенд ставит SET на тестовый мультикуб, справочник,
# версию и скрипт, потом возвращает RESTORE. RESTORE укажите таким, какой стоит сейчас.
OM_TEST_ROLE_ID=
OM_TEST_VERSION_ID=
OM_TEST_PERMISSION_SET=read
OM_TEST_PERMISSION_RESTORE=write

# UAM: справочник, элемент, пользователь (id или имя/e-mail), уровни SET и RESTORE
OM_TEST_UAM_ITEM_ID=
OM_TEST_UAM_USER=
OM_TEST_UAM_SET=read
OM_TEST_UAM_RESTORE=write

# zip с решением оптимизации для import_solution_mapping (из шаблона 05)
OM_TEST_SOLUTION_ZIP=
